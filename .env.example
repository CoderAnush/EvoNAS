# EvoNAS Phase 9 environment template (copy to .env — never commit secrets)
EVONAS_ENV=development
EVONAS_API_HOST=0.0.0.0
EVONAS_API_PORT=8000
EVONAS_API_URL=http://127.0.0.1:8000
EVONAS_LOG_LEVEL=INFO
EVONAS_JSON_LOGS=0
EVONAS_ARTIFACTS_ROOT=artifacts
EVONAS_API_CONFIG=configs/api/default.yaml
EVONAS_DASHBOARD_DEMO=0
EVONAS_DASHBOARD_PORT=8501
